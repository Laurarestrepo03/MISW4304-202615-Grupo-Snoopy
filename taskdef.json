{
    "executionRoleArn": "arn:aws:iam::290281446710:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "portMappings": [
                {
                    "hostPort": 5000,
                    "protocol": "tcp",
                    "containerPort": 5000
                }
            ],
            "image": "<IMAGE1_NAME>",
            "essential": true,
            "environment": [
                {
                    "name": "DB_HOST",
                    "value": "blacklist-app.cmz2kakkscc3.us-east-1.rds.amazonaws.com"
                },
                {
                    "name": "DB_PORT",
                    "value": "5432"
                },
                {
                    "name": "DB_USER",
                    "value": "postgres"
                },
                {
                    "name": "DB_PASSWORD",
                    "value": "blacklist_pass*"
                },
                {
                    "name": "DB_NAME",
                    "value": "postgres"
                },
                {
                    "name": "JWT_SECRET_KEY",
                    "value": "-local-dev-secret-change-me-32-bytes-min"
                },
                {
                    "name": "DB_SSLMODE",
                    "value": "require"
                },
                {
                    "name":"NEW_RELIC_APP_NAME",
                    "value": "blacklist-app-aws"
                },
                {
                    "name": "NEW_RELIC_LOG",
                    "value": "stdout"
                },
                {
                    "name": "NEW_RELIC_DISTRIBUTED_TRACING_ENABLED",
                    "value": "true"
                },
                {
                    "name": "NEW_RELIC_LICENSE_KEY",
                    "value": "a19bc4c62901c7a0991f1b07c852795436e1NRAL"
                },
                {
                    "name": "NEW_RELIC_LOG_LEVEL",
                    "value": "info"
                }
            ],
            "name": "blacklist-app"
        }
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "networkMode": "awsvpc",
    "cpu": "512",
    "memory": "1024",
    "family": "Task-blacklist-app"
}